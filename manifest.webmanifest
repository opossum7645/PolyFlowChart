{
  "name": "PoliFlowchart – Diagrammi di flusso",
  "short_name": "PoliFlowchart",
  "description": "Crea ed esegui diagrammi di flusso su computer, iPad e iPhone",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
